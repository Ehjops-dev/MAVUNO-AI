# Copy this file to .env and fill in your real values.
# Never commit .env.

PORT=4500

# ---------------------------------------------------------------- auth
# DEMO_MODE=1 lets the sidebar profile switcher sign in as a seeded farmer
# with one click (it still receives a real signed session token).
# Set DEMO_MODE=0 to require a phone number + PIN for every sign-in.
DEMO_MODE=1

# PIN given to the three seeded demo farmers on first run. Ignored once a
# farmer already has a PIN stored.
DEMO_PIN=1234

# The platform administrator, seeded on first run only if no admin account
# exists yet. Signs in at the same login form as a farmer, with the same PIN
# rules, and lands in the control centre because of the role on the account
# row. CHANGE BOTH before deploying anywhere real — these defaults are
# published in the README.
ADMIN_PHONE=+254 700 000 000
ADMIN_PIN=2468

# HMAC key for session tokens. Leave blank in development and a random key is
# generated per boot (restarting invalidates old sessions). Set a long random
# value in production so sessions survive a restart.
SESSION_SECRET=

# How long a session lasts before the farmer must sign in again.
SESSION_TTL_MINUTES=120

# ---------------------------------------------------------------- limits
# Hard ceiling on what one farmer can be disbursed in a rolling 24 hours,
# regardless of tier. A backstop against a bug or an abusive client.
DAILY_DISBURSEMENT_CAP=150000

# Give up on a PayHero call that has not answered in this many milliseconds.
PAYHERO_TIMEOUT_MS=15000

# Per-IP fixed-window request limits (requests per minute).
RATE_LIMIT_AUTH=10
RATE_LIMIT_WRITE=60
RATE_LIMIT_READ=600

# ---------------------------------------------------------------- serving
# Comma-separated origins allowed to call the API cross-origin. Empty means
# same-origin only, which is correct when this process also serves the SPA.
ALLOWED_ORIGINS=

# QUIET_LOGS=1 suppresses the per-request log line (used by the test suite).
QUIET_LOGS=

# ---------------------------------------------------------------- payhero
# Option A: paste PayHero's Basic token without the "Basic " prefix.
PAYHERO_BASIC_AUTH=

# Option B: use username/password instead of PAYHERO_BASIC_AUTH.
PAYHERO_USERNAME=
PAYHERO_PASSWORD=

# Required for live PayHero B2C M-PESA disbursement.
PAYHERO_CHANNEL_ID=

# Required for live callback updates. Use your deployed URL or ngrok/cloudflared URL.
PAYHERO_CALLBACK_URL=https://your-public-domain.com/api/payhero/callback
