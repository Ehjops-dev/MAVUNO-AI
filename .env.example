# Copy this file to .env and fill in your real PayHero values.
# Never commit .env.

PORT=4501

# Option A: paste PayHero's Basic token without the "Basic " prefix.
PAYHERO_BASIC_AUTH=

# Option B: use username/password instead of PAYHERO_BASIC_AUTH.
PAYHERO_USERNAME=
PAYHERO_PASSWORD=

# Required for live PayHero B2C M-PESA disbursement.
PAYHERO_CHANNEL_ID=

# Required for live callback updates. Use your deployed URL or ngrok/cloudflared URL.
PAYHERO_CALLBACK_URL=https://your-public-domain.com/api/payhero/callback
